#!/usr/bin/env bash
# secret: API tokens in the OS secret store instead of dotfiles.
#
#   secret set NAME              store a value, read from a hidden prompt or stdin
#   secret get NAME              print it (for $(...))
#   secret ls                    list the names, never the values
#   secret rm NAME               delete it
#   secret run [--optional] -n NAME [-n NAME]... -- CMD [ARG]...
#   secret run [--optional] --all -- CMD [ARG]...
#                                run CMD with those secrets in its environment only
#   secret export NAME...        print `export NAME='value'` lines for eval
#   secret import [--dry-run] [--remove] FILE [NAME]...
#                                move literal `export NAME=value` lines into the store
#   secret scan [FILE]...        report token-looking exports in shell startup files
#
# Backends, chosen automatically: the macOS login Keychain (/usr/bin/security),
# libsecret (secret-tool, needs a desktop session's keyring), then pass. With
# none, secret says what to install; it never falls back to a plaintext file.
# TUIDEV_SECRET_BACKEND=keychain|secret-tool|pass picks one.
#
# Plain bash 3.2, no tuidev libs: it is installed alone into ~/.local/bin.
# A value never goes through argv of an external command, eval or a temp file.
# See docs/secrets.md.

set -uo pipefail

# Byte-wise matching, here and in sed, awk and tr, so a value is any bytes.
# The caller's LC_ALL comes back before `secret run` starts its command.
if [[ -n "${LC_ALL+set}" ]]; then _secret_lc_all="$LC_ALL"; else _secret_lc_all=__unset__; fi
export LC_ALL=C

SECRET_SERVICE=tuidev
# The Keychain's CLI, by absolute path so nothing earlier on PATH can stand in
# for it and catch a value. Tests point TUIDEV_SECRET_SECURITY at a fake.
_SECRET_SECURITY="${TUIDEV_SECRET_SECURITY:-/usr/bin/security}"
# Values the Keychain would not print back as-is (any byte outside printable
# ASCII) are stored as this prefix plus hex; see _secret_kc_encode.
_SECRET_HEX_PREFIX='tuidev-hex:'

_secret_err() { printf 'secret: %s\n' "$*" >&2; }
_secret_die() { _secret_err "$1"; exit "${2:-1}"; }

usage() {
    cat <<'EOF'
secret: API tokens in the OS secret store, not in dotfiles

Usage:
  secret set NAME               store a value (hidden prompt, or stdin when piped)
  secret get NAME               print the value
  secret ls                     list names (never values)
  secret rm NAME                delete
  secret run -n NAME... -- CMD  run CMD with those secrets in its environment only
  secret run --all -- CMD       ... with every stored secret (none: CMD runs as is)
  secret export NAME...         print `export NAME='value'` lines: eval "$(secret export A B)"
  secret import [--dry-run] [--remove] FILE [NAME...]
                                store a file's literal `export NAME=value` lines
                                (the token-looking ones, or the NAMEs given);
                                --remove then deletes them from FILE, after a
                                backup that holds no values; --dry-run only
                                lists them (names and line numbers)
  secret scan [FILE...]         list token-looking exports in shell startup files
                                (FILE:LINE: NAME, never the value); exit 1 on a hit

  run --optional                start CMD even when a secret can't be read

The value is never taken from the command line: arguments show in `ps` and in
shell history. NAME is a variable name: [A-Za-z_][A-Za-z0-9_]*. A value is one
line: one trailing line ending is dropped, a newline or NUL inside is refused.

Store: macOS Keychain (service "tuidev"), else secret-tool, else pass
(tuidev/NAME). TUIDEV_SECRET_BACKEND=keychain|secret-tool|pass picks one.
Exit: 0 ok, 1 not found or failed, 2 usage, 3 no secret store.
Docs: docs/secrets.md in the tuidev repo.
EOF
}

# ----------------------------------------------------------------------------
# Names and values
# ----------------------------------------------------------------------------

_secret_valid_name() {
    local re='^[A-Za-z_][A-Za-z0-9_]*$'
    [[ "$1" =~ $re ]]
}

_secret_need_name() {
    [[ -n "${1:-}" ]] || _secret_die "name a secret" 2
    _secret_valid_name "$1" \
        || _secret_die "not a valid name: it must match [A-Za-z_][A-Za-z0-9_]* (a shell variable name)" 2
}

# _secret_read_value NAME — the value from a hidden prompt (stdin a terminal)
# or all of stdin, into _secret_value. One trailing \n or \r\n is dropped.
_secret_read_value() {
    _secret_value=""
    if [[ -t 0 ]]; then
        IFS= read -r -s -p "Value for $1 (input hidden): " _secret_value
        printf '\n' >&2
    elif IFS= read -r -d '' _secret_value; then
        # read stopped at a NUL before the end of the input.
        _secret_die "the value contains a NUL byte, which a secret can't hold"
    fi
    _secret_value="${_secret_value%$'\n'}"
    _secret_value="${_secret_value%$'\r'}"
    case "$_secret_value" in
        "") _secret_die "empty value: nothing stored" ;;
        *$'\n'*) _secret_die "the value has more than one line; a secret is one line" ;;
    esac
}

# Single-quoted for the shell: only ' needs care.
_secret_squote() {
    local sq="'" q="'\\''"
    printf "'%s'" "${1//$sq/$q}"
}

# ----------------------------------------------------------------------------
# Backends: each has _get (value on stdout; 1 = not found), _put (value on
# stdin, one line), _rm (1 = not found) and _ls (names, one per line).
# ----------------------------------------------------------------------------

_secret_backend=""
_secret_pick_backend() {
    [[ -n "$_secret_backend" ]] && return 0
    case "${TUIDEV_SECRET_BACKEND:-}" in
        keychain|secret-tool|pass) _secret_backend="$TUIDEV_SECRET_BACKEND" ;;
        "")
            if [[ "$(uname -s 2>/dev/null)" == Darwin ]]; then
                _secret_backend=keychain
            elif command -v secret-tool >/dev/null 2>&1 \
                 && [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" || -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]]; then
                _secret_backend=secret-tool
            elif command -v pass >/dev/null 2>&1; then
                _secret_backend=pass
            else
                _secret_err "no secret store found, so nothing was stored (secret never writes a plaintext file)."
                _secret_err "Install one:"
                _secret_err "  desktop Linux:  libsecret-tools (apt), libsecret (dnf, pacman): the GNOME/KDE keyring"
                _secret_err "  headless:       pass (apt/dnf/pacman install pass), then: gpg --gen-key; pass init KEY-ID"
                exit 3
            fi
            ;;
        *) _secret_die "TUIDEV_SECRET_BACKEND must be keychain, secret-tool or pass" 2 ;;
    esac
    case "$_secret_backend" in
        keychain)
            [[ -x "$_SECRET_SECURITY" ]] || _secret_die "the macOS Keychain CLI ($_SECRET_SECURITY) is missing" 3 ;;
        secret-tool|pass)
            command -v "$_secret_backend" >/dev/null 2>&1 \
                || _secret_die "$_secret_backend is not installed (TUIDEV_SECRET_BACKEND=$_secret_backend)" 3 ;;
    esac
}

# --- macOS Keychain: generic passwords, service "tuidev", account NAME ------
#
# `security add-generic-password -w VALUE` would put the value in argv, and the
# prompting form needs a terminal. Instead the command goes to `security -i`
# on stdin, with the value as hex (-X), so it is in a pipe, never in argv.
# `find-generic-password -w` prints a value with bytes outside printable ASCII
# as hex, which can't be told from a hex token, so such a value (or one that
# starts with the prefix itself) is stored as tuidev-hex:<hex>.

_secret_hex() { od -An -v -tx1 | tr -d ' \n'; }

_secret_unhex() {
    local hex="$1" out="" oct i
    [[ $(( ${#hex} % 2 )) -eq 0 && "$hex" != *[!0-9a-fA-F]* ]] || return 1
    for (( i = 0; i < ${#hex}; i += 2 )); do
        printf -v oct '\\0%03o' "$(( 16#${hex:i:2} ))"
        out+="$oct"
    done
    printf '%b' "$out"
}

_secret_kc_encode() {
    case "$1" in
        "$_SECRET_HEX_PREFIX"*|*[!\ -~]*) printf '%s' "$_SECRET_HEX_PREFIX"; printf '%s' "$1" | _secret_hex ;;
        *) printf '%s' "$1" ;;
    esac
}

_secret_keychain_get() {
    local out rc=0
    out="$("$_SECRET_SECURITY" find-generic-password -a "$1" -s "$SECRET_SERVICE" -w 2>/dev/null)" || rc=$?
    if [[ $rc -eq 44 ]]; then return 1; fi   # errSecItemNotFound
    if [[ $rc -ne 0 ]]; then
        _secret_err "the Keychain refused to read $1 (security exit $rc): locked, or blocked by a sandbox?"
        return 2
    fi
    if [[ "$out" == "$_SECRET_HEX_PREFIX"* ]]; then
        _secret_unhex "${out#"$_SECRET_HEX_PREFIX"}" || { _secret_err "$1: stored value is damaged"; return 2; }
    else
        printf '%s' "$out"
    fi
}

_secret_keychain_put() {
    local value hex
    IFS= read -r value || [[ -n "$value" ]] || return 1
    hex="$(_secret_kc_encode "$value" | _secret_hex)"
    # -l is the item's name in Keychain Access (the secret's own name, not
    # "tuidev" on every row) and -D its kind; the service and account stay the
    # lookup key. No spaces in either: `security -i` splits its line on them.
    printf 'add-generic-password -U -a %s -s %s -l %s -D %s -X %s\n' "$1" "$SECRET_SERVICE" "$1" secret "$hex" \
        | "$_SECRET_SECURITY" -q -i >/dev/null
}

_secret_keychain_rm() {
    local rc=0
    "$_SECRET_SECURITY" delete-generic-password -a "$1" -s "$SECRET_SERVICE" >/dev/null 2>&1 || rc=$?
    [[ $rc -eq 44 ]] && return 1
    [[ $rc -eq 0 ]] || { _secret_err "the Keychain refused to delete $1 (security exit $rc)"; return 2; }
}

# Attributes only: dump-keychain without -d never prints a value.
_secret_keychain_ls() {
    "$_SECRET_SECURITY" dump-keychain 2>/dev/null | awk -v svc="$SECRET_SERVICE" '
        function flush() { if (class == "genp" && service == svc && acct != "") print acct; class = service = acct = "" }
        /^keychain: / { flush() }
        /^class: /    { class = $2; gsub(/"/, "", class) }
        /^ *"acct"<blob>="/ { acct = $0; sub(/^ *"acct"<blob>="/, "", acct); sub(/"$/, "", acct) }
        /^ *"svce"<blob>="/ { service = $0; sub(/^ *"svce"<blob>="/, "", service); sub(/"$/, "", service) }
        END { flush() }'
}

# --- libsecret: attributes service=tuidev name=NAME ---------------------------

_secret_secret_tool_get() {
    local out
    out="$(secret-tool lookup service "$SECRET_SERVICE" name "$1")" || return 1
    [[ -n "$out" ]] || return 1
    printf '%s' "$out"
}

_secret_secret_tool_put() {
    local value
    IFS= read -r value || [[ -n "$value" ]] || return 1
    printf '%s' "$value" | secret-tool store --label="$SECRET_SERVICE: $1" service "$SECRET_SERVICE" name "$1"
}

_secret_secret_tool_rm() {
    secret-tool lookup service "$SECRET_SERVICE" name "$1" >/dev/null 2>&1 || return 1
    secret-tool clear service "$SECRET_SERVICE" name "$1"
}

# `search` prints each item's secret too; only attribute.name lines get out.
_secret_secret_tool_ls() {
    secret-tool search --all service "$SECRET_SERVICE" 2>/dev/null | sed -n 's/^attribute\.name = //p'
}

# --- pass: entries tuidev/NAME ----------------------------------------------

_secret_pass_dir() { printf '%s/%s' "${PASSWORD_STORE_DIR:-$HOME/.password-store}" "$SECRET_SERVICE"; }

_secret_pass_get() {
    local out
    [[ -f "$(_secret_pass_dir)/$1.gpg" ]] || return 1
    out="$(pass show "$SECRET_SERVICE/$1")" || { _secret_err "pass could not decrypt $SECRET_SERVICE/$1"; return 2; }
    printf '%s' "${out%%$'\n'*}"
}

# -m reads stdin to EOF as is (-e would go through pass's own echo).
_secret_pass_put() {
    local value
    IFS= read -r value || [[ -n "$value" ]] || return 1
    printf '%s\n' "$value" | pass insert -m -f "$SECRET_SERVICE/$1" >/dev/null
}

_secret_pass_rm() {
    [[ -f "$(_secret_pass_dir)/$1.gpg" ]] || return 1
    pass rm -f "$SECRET_SERVICE/$1" >/dev/null
}

_secret_pass_ls() {
    local f dir
    dir="$(_secret_pass_dir)"
    # No directory yet is an empty store; one that can't be read is a failure.
    [[ ! -e "$dir" ]] || [[ -r "$dir" && -x "$dir" ]] || { _secret_err "pass: cannot read $dir"; return 2; }
    for f in "$dir"/*.gpg; do
        [[ -f "$f" ]] || continue
        f="${f##*/}"; f="${f%.gpg}"
        _secret_valid_name "$f" && printf '%s\n' "$f"
    done
}

# --- dispatch -----------------------------------------------------------------

_secret_be() {
    local op="$1"; shift
    _secret_pick_backend
    "_secret_${_secret_backend//-/_}_$op" "$@"
}

# _secret_fetch NAME — the value into _secret_value; 1 not found, 2 error.
_secret_fetch() {
    local rc=0
    _secret_value="$(_secret_be get "$1")" || rc=$?
    [[ $rc -eq 0 ]] || return "$rc"
    [[ -n "$_secret_value" ]] || return 1
}

# _secret_store NAME — _secret_value into the store, then read back: the store
# holds exactly that value, or this fails.
_secret_store() {
    local want="$_secret_value"
    printf '%s\n' "$want" | _secret_be put "$1" \
        || { _secret_err "the $_secret_backend store refused $1"; return 1; }
    _secret_fetch "$1" && [[ "$_secret_value" == "$want" ]] \
        || { _secret_err "$1 was not stored correctly in the $_secret_backend store"; return 1; }
}

_secret_names() { _secret_be ls | LC_ALL=C sort -u; }

_secret_not_found() { _secret_err "no secret named $1 (see: secret ls)"; }

# ----------------------------------------------------------------------------
# Shell-file parsing (import and scan)
# ----------------------------------------------------------------------------

# _secret_parse LINE — a literal assignment `[export] NAME=VALUE [# comment]`
# sets _p_name and _p_value and returns 0. Not an assignment: 1. An assignment
# whose value isn't one literal word (an expansion, a command, a ~): 2.
_secret_parse() {
    local s="$1" re='^([A-Za-z_][A-Za-z0-9_]*)=(.*)$' rest c nc i n v="" tail
    s="${s%$'\r'}"
    s="${s#"${s%%[![:space:]]*}"}"
    if [[ "$s" == export[[:space:]]* ]]; then
        s="${s#export}"
        s="${s#"${s%%[![:space:]]*}"}"
    fi
    [[ "$s" =~ $re ]] || return 1
    _p_name="${BASH_REMATCH[1]}"
    rest="${BASH_REMATCH[2]}"
    n=${#rest}
    case "${rest:0:1}" in
        "'")
            rest="${rest:1}"
            [[ "$rest" == *"'"* ]] || return 2
            v="${rest%%\'*}"
            tail="${rest#*\'}"
            ;;
        '"')
            i=1; tail=""
            while (( i < n )); do
                c="${rest:i:1}"
                case "$c" in
                    \\)
                        nc="${rest:i+1:1}"
                        case "$nc" in
                            '$'|'`'|'"'|\\) v+="$nc"; i=$((i + 2)) ;;
                            *) v+="$c"; i=$((i + 1)) ;;
                        esac
                        ;;
                    '"') tail="${rest:i+1}"; i=$((n + 1)) ;;
                    '$'|'`') return 2 ;;
                    *) v+="$c"; i=$((i + 1)) ;;
                esac
            done
            (( i == n + 1 )) || return 2   # no closing quote
            ;;
        *)
            i=0
            while (( i < n )); do
                c="${rest:i:1}"
                case "$c" in
                    [[:space:]]) break ;;
                    \\) v+="${rest:i+1:1}"; i=$((i + 2)) ;;
                    '$'|'`'|"'"|'"'|'('|')'|';'|'&'|'|'|'<'|'>') return 2 ;;
                    *) v+="$c"; i=$((i + 1)) ;;
                esac
            done
            [[ "$v" == '~'* ]] && return 2
            tail="${rest:i}"
            ;;
    esac
    tail="${tail#"${tail%%[![:space:]]*}"}"
    [[ -z "$tail" || "$tail" == '#'* ]] || return 2
    [[ -n "$v" ]] || return 2
    _p_value="$v"
}

# _secret_looks_secret NAME VALUE — a credential by its name or its shape.
_secret_looks_secret() {
    local name="$1" v="$2" up
    up="$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')"
    case "$v" in
        /*|./*|../*) return 1 ;;
    esac
    # By shape, whatever the name.
    case "$v" in
        ghp_?????????????????*|gho_?????????????????*|ghu_?????????????????*|ghs_?????????????????*|ghr_?????????????????*|github_pat_*) return 0 ;;
        glpat-?????????????*|xox[abprs]-*|xapp-*|npm_????????????????*|hf_????????????????*|pypi-????????????????*) return 0 ;;
        sk-????????????????*|sk_live_*|sk_test_*|rk_live_*|AKIA????????????????|ASIA????????????????|AIza???????????????????????????????????) return 0 ;;
        dop_v1_*|-----BEGIN*|eyJ*.*.*) return 0 ;;
        *://*:*@*) [[ "$v" == *://:@* ]] || return 0 ;;
    esac
    # By name.
    case "$up" in
        *_KEY_ID|*_KEYID|*_KEY_PATH|*_KEY_FILE|*_TOKEN_PATH|*_TOKEN_FILE|*_PASSWORD_FILE) ;;
        *TOKEN*|*SECRET*|*PASSW*|*API_KEY*|*APIKEY*|*_KEY|*PRIVATE_KEY*|*ACCESS_KEY*|*CREDENTIAL*|*_PAT|*_AUTH|AUTH_*|*_AUTH_*|*_DSN)
            case "$v" in true|false|yes|no|on|off|TRUE|FALSE|YES|NO|ON|OFF) return 1 ;; esac
            (( ${#v} >= 8 )) && return 0
            ;;
    esac
    # A long, random-looking word: letters and digits, at least 32 characters.
    if (( ${#v} >= 32 )) && [[ "$v" != *[!A-Za-z0-9_+/=.-]* && "$v" == *[0-9]* && "$v" == *[A-Za-z]* ]]; then
        return 0
    fi
    return 1
}

# The shell startup files `secret scan` reads by default.
_secret_default_files() {
    local f
    for f in "$HOME/.zshrc" "$HOME/.zshrc.local" "$HOME/.zprofile" "$HOME/.zshenv" \
             "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile" "$HOME"/.config/zsh/*.zsh; do
        [[ -f "$f" ]] && printf '%s\n' "$f"
    done
    return 0
}

# ----------------------------------------------------------------------------
# Commands
# ----------------------------------------------------------------------------

cmd_set() {
    _secret_need_name "${1:-}"
    if (( $# > 1 )); then
        _secret_die "secret set takes only a NAME: the value comes from a prompt or stdin, never from arguments (they show in ps and shell history)" 2
    fi
    _secret_pick_backend
    local existed=false
    _secret_fetch "$1" >/dev/null 2>&1 && existed=true
    _secret_read_value "$1"
    _secret_store "$1" || exit 1
    if [[ "$existed" == true ]]; then
        printf 'secret: updated %s (%d bytes) in the %s store\n' "$1" "${#_secret_value}" "$_secret_backend" >&2
    else
        printf 'secret: stored %s (%d bytes) in the %s store\n' "$1" "${#_secret_value}" "$_secret_backend" >&2
    fi
}

cmd_get() {
    _secret_need_name "${1:-}"
    (( $# == 1 )) || _secret_die "usage: secret get NAME" 2
    local rc=0
    _secret_fetch "$1" || rc=$?
    case "$rc" in
        0) printf '%s\n' "$_secret_value" ;;
        1) _secret_not_found "$1"; exit 1 ;;
        *) exit 1 ;;
    esac
}

cmd_ls() {
    (( $# == 0 )) || _secret_die "usage: secret ls" 2
    local rc=0
    _secret_names || rc=$?
    [[ $rc -eq 0 || $rc -eq 3 ]] || rc=1
    return "$rc"
}

cmd_rm() {
    _secret_need_name "${1:-}"
    (( $# == 1 )) || _secret_die "usage: secret rm NAME" 2
    local rc=0
    _secret_be rm "$1" || rc=$?
    case "$rc" in
        0) printf 'secret: removed %s\n' "$1" >&2 ;;
        1) _secret_not_found "$1"; exit 1 ;;
        *) exit 1 ;;
    esac
}

cmd_run() {
    local names=() all=false optional=false name rc
    while (( $# > 0 )); do
        case "$1" in
            -n|--name)
                (( $# >= 2 )) || _secret_die "-n needs a NAME" 2
                _secret_need_name "$2"; names+=("$2"); shift 2 ;;
            --all) all=true; shift ;;
            --optional) optional=true; shift ;;
            --) shift; break ;;
            *) _secret_die "secret run: unknown option '$1' (usage: secret run -n NAME... -- CMD)" 2 ;;
        esac
    done
    (( $# > 0 )) || _secret_die "secret run: no command after --" 2
    # --all: every name the store lists. An empty store adds nothing (not an
    # error); a listing that fails stops CMD, unless --optional.
    if [[ "$all" == true ]]; then
        local listed=""
        rc=0
        listed="$(_secret_names)" || rc=$?
        if [[ $rc -ne 0 ]]; then
            [[ $rc -eq 3 ]] || rc=1    # 3: no store at all; anything else, the store failed
            [[ "$optional" == true ]] || _secret_die "not running $1: the secret store could not be listed (--optional runs it anyway)" "$rc"
            _secret_err "the secret store could not be listed; running without its secrets"
            listed=""
        fi
        while IFS= read -r name; do
            [[ -n "$name" ]] && names+=("$name")
        done <<< "$listed"
    elif (( ${#names[@]} == 0 )); then
        _secret_die "secret run: name a secret with -n NAME, or use --all" 2
    fi
    for name in ${names[@]+"${names[@]}"}; do
        rc=0
        _secret_fetch "$name" || rc=$?
        if [[ $rc -eq 0 ]]; then
            export "$name=$_secret_value"
        elif [[ "$optional" == true ]]; then
            _secret_err "$name not available; running without it"
        else
            [[ $rc -eq 1 ]] && _secret_not_found "$name"
            _secret_die "not running $1: $name is not available (--optional runs it anyway)"
        fi
    done
    _secret_value=""
    if [[ "$_secret_lc_all" == __unset__ ]]; then unset LC_ALL; else LC_ALL="$_secret_lc_all"; fi
    exec "$@"
}

cmd_export() {
    (( $# > 0 )) || _secret_die "usage: secret export NAME..." 2
    local name status=0 rc
    for name in "$@"; do _secret_need_name "$name"; done
    for name in "$@"; do
        rc=0
        _secret_fetch "$name" || rc=$?
        if [[ $rc -eq 0 ]]; then
            printf 'export %s=%s\n' "$name" "$(_secret_squote "$_secret_value")"
        else
            [[ $rc -eq 1 ]] && _secret_not_found "$name"
            status=1
        fi
    done
    return "$status"
}

cmd_scan() {
    local files=() f line ln hits=0 rc
    if (( $# > 0 )); then
        files=("$@")
    else
        while IFS= read -r f; do files+=("$f"); done < <(_secret_default_files)
    fi
    for f in ${files[@]+"${files[@]}"}; do
        if [[ ! -r "$f" || -d "$f" ]]; then
            _secret_err "can't read $f"
            continue
        fi
        ln=0
        while IFS= read -r line || [[ -n "$line" ]]; do
            ln=$((ln + 1))
            rc=0
            _secret_parse "$line" || rc=$?
            [[ $rc -eq 0 ]] || continue
            if _secret_looks_secret "$_p_name" "$_p_value"; then
                printf '%s:%d: %s\n' "$f" "$ln" "$_p_name"
                hits=$((hits + 1))
            fi
        done < "$f"
    done
    _p_value=""
    if (( hits > 0 )); then
        _secret_err "$hits token-looking export(s) above. Move them into the store: secret import --remove FILE"
        return 1
    fi
}

cmd_import() {
    local remove=false dry=false file want=() line ln rc name i
    while (( $# > 0 )); do
        case "$1" in
            --remove) remove=true; shift ;;
            -n|--dry-run) dry=true; shift ;;
            --) shift; break ;;
            -*) _secret_die "secret import: unknown option '$1'" 2 ;;
            *) break ;;
        esac
    done
    file="${1:-}"; shift || true
    [[ -n "$file" ]] || _secret_die "usage: secret import [--dry-run] [--remove] FILE [NAME...]" 2
    [[ -f "$file" && -r "$file" ]] || _secret_die "can't read $file" 1
    for name in "$@"; do _secret_need_name "$name"; want+=("$name"); done
    if [[ "$remove" == true && ! -w "$file" ]]; then
        _secret_die "can't write $file, so --remove can't take the lines out" 1
    fi

    # Pass 1: pick the lines. The last assignment of a name wins, as in a shell.
    local pick_names=() pick_values=() pick_lines=() remove_lines=" " found
    ln=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        ln=$((ln + 1))
        rc=0
        _secret_parse "$line" || rc=$?
        [[ $rc -eq 0 ]] || continue
        if (( ${#want[@]} > 0 )); then
            case " ${want[*]} " in *" $_p_name "*) ;; *) continue ;; esac
        else
            _secret_looks_secret "$_p_name" "$_p_value" || continue
        fi
        remove_lines+="$ln "
        found=false
        for (( i = 0; i < ${#pick_names[@]}; i++ )); do
            if [[ "${pick_names[i]}" == "$_p_name" ]]; then
                pick_values[i]="$_p_value"; pick_lines[i]+=", $ln"; found=true
            fi
        done
        if [[ "$found" == false ]]; then
            pick_names+=("$_p_name"); pick_values+=("$_p_value"); pick_lines+=("$ln")
        fi
    done < "$file"
    _p_value=""

    for name in ${want[@]+"${want[@]}"}; do
        case " ${pick_names[*]-} " in
            *" $name "*) ;;
            *) _secret_die "$file has no literal assignment of $name (an expansion such as \$(...) or \$VAR is not imported)" ;;
        esac
    done
    if (( ${#pick_names[@]} == 0 )); then
        printf 'secret: nothing to import from %s\n' "$file" >&2
        return 0
    fi

    # The plan, names and line numbers only, before anything is stored or changed.
    local verb=store
    [[ "$remove" == true ]] && verb="store, then remove from the file"
    [[ "$dry" == true ]] && verb="would $verb (dry run: nothing is stored or changed)"
    printf 'secret: %s: %s\n' "$file" "$verb" >&2
    for (( i = 0; i < ${#pick_names[@]}; i++ )); do
        printf '  %s  (line %s)\n' "${pick_names[i]}" "${pick_lines[i]}" >&2
    done
    if [[ "$dry" == true ]]; then
        return 0
    fi

    # Pass 2: store each one; any failure stops before the file is touched.
    _secret_pick_backend
    for (( i = 0; i < ${#pick_names[@]}; i++ )); do
        _secret_value="${pick_values[i]}"
        pick_values[i]=""
        _secret_store "${pick_names[i]}" \
            || _secret_die "stopped: ${pick_names[i]} not stored; $file is unchanged"
        printf 'secret: stored %s in the %s store\n' "${pick_names[i]}" "$_secret_backend" >&2
    done
    _secret_value=""

    if [[ "$remove" != true ]]; then
        printf 'secret: %s still holds the values; run again with --remove to take them out\n' "$file" >&2
        return 0
    fi

    # Pass 3: the backup (removed lines redacted), then the file without them.
    # Written in place, so the file keeps its mode, owner and any symlink.
    local stamp backup out="" bak="" note
    stamp="$(date +%Y%m%d-%H%M%S)"
    backup="$file.secret-backup-$stamp"
    ln=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        ln=$((ln + 1))
        case "$remove_lines" in
            *" $ln "*)
                _secret_parse "$line" || true
                note="# $_p_name: moved to the secret store by secret import ($stamp); secret get $_p_name"
                out+="$note"$'\n'
                bak+="# $_p_name=<removed by secret import; the value is in the secret store>"$'\n'
                ;;
            *) out+="$line"$'\n'; bak+="$line"$'\n' ;;
        esac
    done < "$file"
    _p_value=""
    ( umask 077; printf '%s' "$bak" > "$backup" ) || _secret_die "could not write the backup $backup; $file is unchanged"
    printf '%s' "$out" > "$file" || _secret_die "could not rewrite $file (backup: $backup)"
    printf 'secret: removed %d line(s) from %s (backup without the values: %s)\n' \
        "$(( $(printf '%s' "$remove_lines" | wc -w) ))" "$file" "$backup" >&2
}

main() {
    local cmd="${1:-}"
    (( $# > 0 )) && shift
    # The store is picked here, in this shell, so "no store" exits 3 before
    # any prompt (scan needs none; import picks it once it has lines to store).
    case "$cmd" in
        set|get|ls|list|rm|delete|run|export) _secret_pick_backend ;;
    esac
    case "$cmd" in
        set) cmd_set "$@" ;;
        get) cmd_get "$@" ;;
        ls|list) cmd_ls "$@" ;;
        rm|delete) cmd_rm "$@" ;;
        run) cmd_run "$@" ;;
        export) cmd_export "$@" ;;
        import) cmd_import "$@" ;;
        scan) cmd_scan "$@" ;;
        -h|--help|help) usage ;;
        "") usage >&2; exit 2 ;;
        *) _secret_err "unknown command '$cmd'"; usage >&2; exit 2 ;;
    esac
}

main "$@"
