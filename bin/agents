#!/usr/bin/env bash
# agents — see and control the agentic-coding processes on this machine.
#
# One `ps` snapshot per run, classified in a single awk pass:
#   agents    every `claude` / `codex` process tree (the Codex app-server
#             daemon gets its own row, tagged `daemon`), with tree CPU and
#             memory, cwd, listening ports and Herdr status;
#   stale     orphans an agent left behind: MCP servers, `npm exec`/npx
#             helpers, `caffeinate`, and dev servers still listening;
#   hogs      runaway processes of any owner (a Messages.app at 100% for days).
# Plus keep-awake (`caffeinate`; `pmset disablesleep` only through the explicit,
# time-boxed `awake lid`, never by default) and thermal pressure. Installed by
# `./install.sh --pack monitoring`; the SwiftBar plugin
# (configs/swiftbar/agents.10s.sh) reads `agents tsv`.
#
# This file is only the entrypoint: it finds the modules, one per
# responsibility (the map is in docs/engineering.md), and sources them. They
# live in lib/agents/ next to bin/ in a checkout, and in lib/tuidev/agents/
# next to an installed ~/.local/bin/agents, so it runs without the repo.
# Sourcing this file defines the functions and runs nothing
# (scripts/lib/test_agents*.sh do that). bash 3.2.

# This script, as run (open-term and `awake agents` start it again).
AGENTS_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# _agents_find_lib SCRIPT — set _AGENTS_LIB to the module directory for the
# agents at SCRIPT: PREFIX/lib/agents (a checkout) or PREFIX/lib/tuidev/agents
# (an install), where SCRIPT is PREFIX/bin/agents, following symlinks to it
# (and, once, a symlinked directory on its path). False when there is none.
_agents_find_lib() {
    local s="$1" d n=0
    while [[ $n -lt 32 ]]; do
        n=$((n + 1))
        d="${s%/*}"; d="${d%/*}"
        for _AGENTS_LIB in "$d/lib/agents" "$d/lib/tuidev/agents"; do
            [[ -f "$_AGENTS_LIB/cli.sh" ]] && return 0
        done
        if [[ -L "$s" ]]; then
            d="$(readlink "$s")" || break
            case "$d" in /*) s="$d" ;; *) s="${s%/*}/$d" ;; esac
        else
            d="$(cd -P "${s%/*}" 2>/dev/null && pwd)" || break
            [[ "$d/${s##*/}" != "$s" ]] || break
            s="$d/${s##*/}"
        fi
    done
    _AGENTS_LIB=""
    return 1
}

# config first: it reads agents.conf. The others only define functions.
_AGENTS_MODULES="config util snapshot classify watched system awake lid kill notify events reap assess transcript history runs report render json tsv terminal hooks usage cli"

# Every module is checked before any is sourced: never half a program.
_agents_missing=""
if _agents_find_lib "$AGENTS_PATH"; then
    for _agents_m in $_AGENTS_MODULES; do
        [[ -r "$_AGENTS_LIB/$_agents_m.sh" ]] || _agents_missing+=" $_AGENTS_LIB/$_agents_m.sh"
    done
else
    _agents_m="${AGENTS_PATH%/*}"
    _agents_missing=" ${_agents_m%/*}/lib/tuidev/agents/"
fi
if [[ -n "$_agents_missing" ]]; then
    echo "agents: missing$_agents_missing (reinstall: ./install.sh --pack monitoring)" >&2
    if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then exit 1; fi
    return 1
fi
_AGENTS_AWK_DIR="$_AGENTS_LIB/awk"
for _agents_m in $_AGENTS_MODULES; do
    # shellcheck source=/dev/null  # each module is linted on its own (Makefile SHELL_FILES)
    . "$_AGENTS_LIB/$_agents_m.sh"
done
unset _agents_m _agents_missing

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    agents_main "$@"
fi
