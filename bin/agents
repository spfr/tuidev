#!/usr/bin/env bash
# agents — see and control the agentic-coding processes on this machine.
#
# One `ps` snapshot per run, classified in a single awk pass:
#   agents    every `claude` / `codex` process tree (the Codex app-server
#             daemon gets its own row, tagged `daemon`), with tree CPU and
#             memory, cwd, listening ports and Herdr status;
#   stale     orphans an agent left behind: MCP servers, `npm exec`/npx
#             helpers, `caffeinate`, and dev servers still listening;
#   hogs      runaway processes of any owner (a Messages.app at 100% for days).
# Plus keep-awake (`caffeinate`; `pmset disablesleep` only through the explicit,
# time-boxed `awake lid`, never by default) and thermal pressure. Installed by
# `./install.sh --pack monitoring`; the SwiftBar plugin
# (configs/swiftbar/agents.10s.sh) reads `agents tsv`.
#
# This file is only the entrypoint: it finds the modules, one per
# responsibility (the map is in docs/engineering.md), and sources them. They
# live in lib/agents/ next to bin/ in a checkout, and in lib/tuidev/agents/
# next to an installed ~/.local/bin/agents, so it runs without the repo.
# Sourcing this file defines the functions and runs nothing
# (scripts/lib/test_agents*.sh do that). bash 3.2.

# This script, as run (open-term and `awake agents` start it again).
# Run by its absolute path (from PATH, or SwiftBar), it needs no fork.
_agents_m="${BASH_SOURCE[0]}"
case "$_agents_m" in */*) _agents_d="${_agents_m%/*}" ;; *) _agents_d=. ;; esac
case "${_agents_d:-/}/" in
    /*//*|*/./*|*/../*|[!/]*) AGENTS_PATH="$(cd "${_agents_d:-/}" && pwd)/${_agents_m##*/}" ;;
    *) AGENTS_PATH="$_agents_d/${_agents_m##*/}" ;;
esac
unset _agents_d

# _agents_find_lib SCRIPT — set _AGENTS_LIB to the module directory of the
# agents at SCRIPT: PREFIX/lib/agents (a checkout) or PREFIX/lib/tuidev/agents
# (an install). PREFIX/bin/agents is first the file SCRIPT resolves to (its
# symlinks, and symlinked directories on its path, followed), so a link to a
# checkout runs the checkout's modules even beside an older install; then
# SCRIPT itself (a copy whose modules sit beside it). False when neither has
# them. Forks only to follow a symlink.
_agents_find_lib() {
    local s="$1" d n=0
    while [[ $n -lt 32 ]]; do
        n=$((n + 1))
        if [[ -L "$s" ]]; then
            d="$(readlink "$s")" || break
            case "$d" in /*) s="$d" ;; *) s="${s%/*}/$d" ;; esac
            continue
        fi
        # A symlinked directory, or a .. or ., on its path (tests, no forks).
        d="${s%/*}"
        case "$d/" in */../*|*/./*) ;; *) while [[ -n "$d" && ! -L "$d" ]]; do d="${d%/*}"; done ;; esac
        [[ -n "$d" ]] || break
        d="$(cd -P "${s%/*}" 2>/dev/null && pwd)" || break
        s="$d/${s##*/}"
    done
    for s in "$s" "$1"; do
        d="${s%/*}"; d="${d%/*}"
        for _AGENTS_LIB in "$d/lib/agents" "$d/lib/tuidev/agents"; do
            [[ -f "$_AGENTS_LIB/cli.sh" ]] || continue
            # Spelled as the path it was run as, when that is the same directory.
            s="${1%/*}"; s="${s%/*}/${_AGENTS_LIB#"$d"/}"
            [[ "$s" == "$_AGENTS_LIB" || ! "$s" -ef "$_AGENTS_LIB" ]] || _AGENTS_LIB="$s"
            return 0
        done
    done
    _AGENTS_LIB=""
    return 1
}

# config first: it reads agents.conf. The others only define functions.
_AGENTS_MODULES="config util snapshot classify mcp lazy where watched system awake lid kill notify events reap assess transcript history runs tokens grok limits statusline context report render json tsv terminal activity show pick hooks usage cli"
# The awk programs the modules run (awk/NAME.awk; test_agents_install.sh keeps
# this list and the directory in step).
_AGENTS_AWK_FILES="assess classify enrich hook_children hook_claude hook_match json lib_activity lib_fmt lib_jobs lib_json lib_price lib_proc lib_sort lib_where limits mcp mcp_toml mcp_toml_launch mcp_view new_members pick refusal render report report_context report_denials report_fmt report_insights report_runs report_tokens report_views report_waits root runs runs_obs runs_view sample show show_tree statusline tokens tokens_plan tokens_rollup tokens_session tokens_state tree where"

# Every module and awk program is checked before any is sourced: never half a
# program.
_agents_missing=""
if _agents_find_lib "$AGENTS_PATH"; then
    for _agents_m in $_AGENTS_MODULES; do
        [[ -r "$_AGENTS_LIB/$_agents_m.sh" ]] || _agents_missing+=" $_AGENTS_LIB/$_agents_m.sh"
    done
    for _agents_m in $_AGENTS_AWK_FILES; do
        [[ -r "$_AGENTS_LIB/awk/$_agents_m.awk" ]] || _agents_missing+=" $_AGENTS_LIB/awk/$_agents_m.awk"
    done
else
    _agents_m="${AGENTS_PATH%/*}"
    _agents_missing=" ${_agents_m%/*}/lib/tuidev/agents/"
fi
if [[ -n "$_agents_missing" ]]; then
    echo "agents: missing$_agents_missing (reinstall: ./install.sh --pack monitoring)" >&2
    if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then exit 1; fi
    return 1
fi
_AGENTS_AWK_DIR="$_AGENTS_LIB/awk"
for _agents_m in $_AGENTS_MODULES; do
    # shellcheck source=/dev/null  # each module is linted on its own (Makefile SHELL_FILES)
    . "$_AGENTS_LIB/$_agents_m.sh"
done
unset _agents_m _agents_missing

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    agents_main "$@"
fi
