# Shared by every tape here (Source docs/assets/tapes/theme.tape): the
# Tokyo Night palette from configs/themes/tokyo-night/palette.toml and the
# font from configs/ghostty/config. Tapes run from the repo root.
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 16
Set LineHeight 1.1
Set Padding 22
Set WindowBar Colorful
Set BorderRadius 10
Set Margin 16
Set MarginFill "#16161e"
Set TypingSpeed 35ms
Set CursorBlink false
Set Theme { "name": "tuidev-tokyo-night", "background": "#1a1b26", "foreground": "#c0caf5", "cursor": "#c0caf5", "selection": "#33467c", "black": "#15161e", "red": "#f7768e", "green": "#9ece6a", "yellow": "#e0af68", "blue": "#7aa2f7", "magenta": "#bb9af7", "cyan": "#7dcfff", "white": "#a9b1d6", "brightBlack": "#414868", "brightRed": "#f7768e", "brightGreen": "#9ece6a", "brightYellow": "#e0af68", "brightBlue": "#7aa2f7", "brightMagenta": "#bb9af7", "brightCyan": "#7dcfff", "brightWhite": "#c0caf5" }
