# SHA-256 of every configs/vim/vimrc version tuidev has ever shipped.
# The vim pack replaces ~/.vim/vimrc only when it is an unmodified copy of one
# of these (backup first); a file you edited is left alone. test_contract.sh
# fails if the current file is not listed: after editing it, append
# `vimrc $(shasum -a 256 vimrc | cut -d' ' -f1)`.
