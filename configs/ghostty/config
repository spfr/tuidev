# ============================================================================
# Ghostty Terminal Configuration (1.3.x; macOS 27 aware)
# Optimized for AI development and multi-agent workflows
# Only non-defaults live here: `ghostty +show-config --default --docs`
# ============================================================================

# TERM stays at the default `xterm-ghostty`: tmux and every modern TUI detect
# Ghostty's features from it, and ssh-terminfo/ssh-env (below) cover remotes.

# ============================================================================
# Font Configuration
# ============================================================================

# Programming ligatures (=>, !=, >=) are on by default; `font-feature = -calt`
# turns them off.
font-family = "JetBrains Mono"
font-size = 14

# ============================================================================
# Theme & Colors (Tokyo Night)
# ============================================================================

background = 1a1b26
foreground = c0caf5

# Cursor
cursor-color = c0caf5
cursor-style-blink = true

# Selection
selection-background = 33467c
selection-foreground = c0caf5

# Normal colors
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6

# Bright colors
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5

# ============================================================================
# Window Configuration
# ============================================================================

window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

# Window decorations
window-decoration = auto
window-theme = dark

# ============================================================================
# Shell Integration
# ============================================================================

# Adds to the defaults (cursor, title, path): sudo keeps TERM through sudo;
# ssh-terminfo installs Ghostty's terminfo on remotes, and ssh-env falls back
# to xterm-256color where that fails.
shell-integration-features = sudo,ssh-env,ssh-terminfo

# ============================================================================
# Performance
# ============================================================================

resize-overlay = never
mouse-hide-while-typing = true

# Large scrollback for AI agent output. The unit is bytes per surface (the
# 1.3 default is 10 MB); tmux panes keep their own history-limit instead.
scrollback-limit = 50000000

# ============================================================================
# Keybindings
# ============================================================================
# macOS defaults stay (cmd+t/w/d, cmd+shift+d, ctrl+tab, ...); these add the
# ctrl+shift chords Linux users expect. Shift+Enter, Home and End need no
# bindings: Ghostty encodes them natively, which Claude Code and tmux
# (extended-keys) rely on.

# Tab management
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface

# Split management (ctrl+alt+* is Rectangle's; down splits use cmd+shift+d)
keybind = ctrl+shift+d=new_split:right

# Window management
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+enter=toggle_fullscreen

# Font size
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Copy/Paste
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Scrollback
keybind = ctrl+shift+up=scroll_page_up
keybind = ctrl+shift+down=scroll_page_down

# Quick edit (open scrollback in editor)
keybind = ctrl+shift+e=write_scrollback_file:open

# Quick terminal (system-wide dropdown terminal)
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# ============================================================================
# Clipboard
# ============================================================================

# Programs may write the clipboard (OSC 52: nvim/tmux over ssh) by default;
# reads prompt first so a remote program can't silently take its contents.
clipboard-read = ask

# ============================================================================
# Miscellaneous
# ============================================================================

# Mouse
focus-follows-mouse = true

# ============================================================================
# Split Pane Settings (v1.3+)
# ============================================================================

# Dim unfocused splits so active pane is obvious
unfocused-split-opacity = 0.85

# ============================================================================
# Notifications (v1.3+)
# ============================================================================

# Notify when long-running commands finish (useful for AI agent tasks)
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s

# ============================================================================
# macOS Specific
# ============================================================================

# Option key behavior (useful for macOS)
macos-option-as-alt = true

# Titlebar / tabs: keep the default `transparent` style. `tabs` (tab bar
# inside the titlebar) is broken on macOS 27 with the stable 1.3.1 build:
# the tab strip collapses into a tiny box beside the "+" button. The fix
# (ghostty-org/ghostty#13069, tracked in #13070) ships only on the tip
# channel until 1.4.0. To get titlebar tabs back on macOS 27, switch to tip
# (auto-update-channel below) and set `macos-titlebar-style = tabs`.

# Auto-update. Set `auto-update-channel = tip` on macOS 27 if you want
# the titlebar-tabs fix before 1.4.0 ships (restart Ghostty afterwards).
auto-update = check
# auto-update-channel = tip
