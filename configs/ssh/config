# ============================================================================
# SSH Client Configuration
# Generated by macOS TUI Development Setup
# ============================================================================
# This config is deployed as a managed block. Personal Host stanzas do not
# belong here — put them in ~/.ssh/config.local (never shipped) or *outside*
# the tuidev managed markers.
#
# `Match all` first: this block is APPENDED to any pre-existing ~/.ssh/config.
# Per ssh_config(5) a bare Include inherits the enclosing Host/Match context, so
# if the user's own config ends in a `Host github.com` stanza the Include would
# only fire for that host and ~/.ssh/config.local would never be read.
# `Match all` unconditionally resets the context so the Include always applies.
#
# Glob form: OpenSSH ignores a missing file when the path contains a glob.
Match all
Include ~/.ssh/config.local*

# Global defaults - keep Tailscale and other long-lived connections alive
Host *
    ServerAliveInterval 60
    ServerAliveCountMax 5
    TCPKeepAlive yes
    AddKeysToAgent yes
    UseKeychain yes
    IdentityFile ~/.ssh/id_ed25519

