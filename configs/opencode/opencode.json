{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "autoupdate": true,
  "share": "manual",
  "snapshot": true,

  "permission": {
    "edit": "ask",
    "bash": "ask",
    "external_directory": "ask",
    "doom_loop": "ask"
  },

  "compaction": {
    "auto": true,
    "prune": true
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "*.log",
      "coverage/**",
      ".next/**",
      "__pycache__/**",
      "*.pyc",
      ".venv/**",
      "target/**"
    ]
  },

  "instructions": [
    "CLAUDE.md"
  ]
}
