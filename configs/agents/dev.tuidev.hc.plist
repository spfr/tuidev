<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  herdr-core in your desktop login (`agents hc up`), installed by
  ./install.sh --pack herdr-core into ~/Library/LaunchAgents. Run once at
  login, before Herdr's phone app can connect over SSH and start a core
  outside the desktop login, where its agents cannot reach the Keychain. A
  core that already runs is left alone. The pack fills in the @...@ values.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.tuidev.hc</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@AGENTS@</string>
        <string>hc</string>
        <string>up</string>
        <string>-q</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@PATH@</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <!-- The core outlives this one-shot job, and is not a Background-band
         process: the agents it hosts must run as they do in a terminal. -->
    <key>AbandonProcessGroup</key>
    <true/>
    <key>ProcessType</key>
    <string>Standard</string>
    <key>StandardErrorPath</key>
    <string>@LOG@</string>
</dict>
</plist>
