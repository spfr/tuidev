# The sampler (`agents sample --scheduled`), installed by ./install.sh --pack
# monitoring into ~/.config/systemd/user (Linux). Started once a minute by
# tuidev-sample.timer: the sample that keeps the history, tokens, runs, waits
# and usage limits current. A sample `agents watch` took within 55 s stands
# (the run then does nothing), and with AGENTS_AUTO_REAP=1 it runs auto-reap.
# Off: AGENTS_SAMPLER=0 in ~/.config/agents.conf (no disable needed), or
# systemctl --user disable --now tuidev-sample.timer until the next tuidev update
# or tuidev check --fix; until then tuidev check warns that it is off.
# Change it with a drop-in (systemctl --user edit tuidev-sample.service): the
# pack writes this file again on every install and update.

[Unit]
Description=agents sample, once a minute (history, tokens, waits, limits)

[Service]
Type=oneshot
ExecStart=/bin/bash %h/.local/bin/agents sample --scheduled
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
Nice=10
IOSchedulingClass=idle
# What agents writes is a warning; systemd's own lines about each run
# (starting, finished) are left out of the journal.
SyslogLevel=warning
LogLevelMax=notice
